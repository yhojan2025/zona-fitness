# ==========================================
# ZONA FITNESS - CONFIGURACIÓN DE ENTORNO
# Archivo de plantilla con valores de ejemplo no funcionales.
# Copie este archivo a .env y configure sus credenciales seguras.
# ==========================================

# Puerto del servidor backend de Node.js / Express
PORT=8000
NODE_ENV=development

# Configuración de Conexión a PostgreSQL 18
# Host y Puerto (predeterminado 5432)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zona_fitness_db

# Usuario de aplicación (con permisos mínimos)
DB_USER=zona_fitness_user
DB_PASSWORD=ejemplo_password_seguro_app_123

# Configuración de superusuario administrativo (usado SOLO para creación inicial de BD y usuario)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=ejemplo_password_postgres_admin

# SSL (disable / prefer / require) - en local generalmente disable
DB_SSL=disable

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET=ejemplo_jwt_secret_zona_fitness_cambiar_en_produccion_xyz123
JWT_EXPIRES_IN=24h
